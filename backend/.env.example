# Hugging Face Hub Token (Get a free one from https://huggingface.co/settings/tokens)
# Highly recommended to populate this to query mistralai/Mistral-Small-3.1-24B-Instruct and BAAI models.
HF_API_KEY=hf_your_key_here

# Local Fallback Mode (Set to true to use SQLite & Local Qdrant file storage)
LOCAL_FALLBACK=true

# --- PostgreSQL Config (used if LOCAL_FALLBACK=false) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/startup_intel

# --- Neo4j Config (used if LOCAL_FALLBACK=false) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Qdrant Config (used if LOCAL_FALLBACK=false) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
